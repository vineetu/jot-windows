<?xml version="1.0" encoding="utf-8"?>

<!-- Sony flavor (-p:Flavor=Sony). SAME Partner Center account/publisher as the public app
     ("Vineet sriram") but a SEPARATE reserved product ("Jot Sie") so it can ship to a Private
     audience without touching the public Jot Transcribe listing. Identity Name/DisplayName below
     MUST match the "Jot Sie" reservation in Partner Center exactly before Store upload — confirm
     them on the product's Identity page (the Name may differ from the placeholder here). -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap2="http://schemas.microsoft.com/appx/manifest/uap/windows10/2"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap2 uap3 uap10 desktop desktop6 rescap">

  <Identity
    Name="Vineetsriram.JotSie"
    Publisher="CN=1269BFA0-02DC-4524-8A77-55C4EE9EADD4"
    Version="1.2.1.0" />

  <Properties>
    <!-- Must match the reserved app name ("Jot Sie") in Partner Center exactly. The friendly tile
         name (VisualElements DisplayName below) is allowed to differ. -->
    <DisplayName>Jot Sie</DisplayName>
    <PublisherDisplayName>Vineet sriram</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.18362.0" MaxVersionTested="10.0.26200.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us"/>
  </Resources>

  <Applications>
    <Application Id="jot"
      Executable="$targetnametoken$.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Jot Sie"
        Description="On-device dictation with the PFB AI Gateway"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\MedTile.png"
        Square44x44Logo="Assets\AppList.png">
        <uap:DefaultTile Wide310x150Logo="Assets\WideTile.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <!-- Jot captures speech to transcribe on-device; the Store listing surfaces this + Windows
         privacy settings gate mic access. -->
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
