<Page x:Class="Jot.Views.VocabularyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Jot.ViewModels"
      Title="Vocabulary">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0 — RecordingDetailPage's header shape, not PromptsPage's. This page has no sidebar
             entry and MainWindow sets IsBackButtonVisible="Collapsed", so without this Back button
             the user lands somewhere with no exit. Not optional. -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0" Appearance="Secondary" Command="{Binding BackCommand}"
                       Icon="{ui:SymbolIcon ArrowLeft24}" ToolTip="Back" Margin="0,0,12,0"
                       AutomationProperties.Name="Back" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Vocabulary" Style="{DynamicResource TitleTextBlockStyle}" />
                <TextBlock Text="{Binding Subtitle, Mode=OneWay}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding ModelNote, Mode=OneWay}" Margin="0,2,0,0" FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding HasModelNote, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Grid>

        <!-- Import results, merges, moved aliases, undo-delete. Never a modal, never a blocking
             error (ux §2.5). -->
        <ui:InfoBar Grid.Row="1" Margin="0,0,0,10" IsClosable="True"
                    IsOpen="{Binding IsStatusOpen, Mode=TwoWay}"
                    Severity="{Binding StatusSeverity}"
                    Message="{Binding StatusMessage}">
            <ui:InfoBar.Content>
                <ui:Button Content="Undo" Margin="0,8,0,0" Appearance="Secondary"
                           Command="{Binding UndoDeleteCommand}"
                           Visibility="{Binding CanUndoDelete, Converter={StaticResource BoolToVis}}" />
            </ui:InfoBar.Content>
        </ui:InfoBar>

        <ui:TextBox Grid.Row="2" Margin="0,0,0,10" PlaceholderText="Search terms"
                    Icon="{ui:SymbolIcon Search24}"
                    Visibility="{Binding ShowSearch, Converter={StaticResource BoolToVis}}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

        <Grid Grid.Row="3">
            <ListView x:Name="TermList" ItemsSource="{Binding Rows}" Background="Transparent" BorderThickness="0"
                      Padding="0,0,12,0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      VirtualizingPanel.ScrollUnit="Item"
                      KeyDown="OnListKeyDown">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:VocabularyTermRow}">
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Text}" FontWeight="SemiBold"
                                               FontFamily="{StaticResource JotMonoFont}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Subtitle}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                                               Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Warning24" FontSize="16" VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Foreground="{DynamicResource JotWarningBrush}"
                                                   ToolTip="{Binding Warning}"
                                                   AutomationProperties.Name="{Binding Warning}"
                                                   Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}" />
                                    <ui:Button Appearance="Transparent" Padding="6"
                                               Command="{Binding DataContext.EditTermCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                               CommandParameter="{Binding}" ToolTip="Edit"
                                               AutomationProperties.Name="{Binding EditName}"
                                               Icon="{ui:SymbolIcon Edit24}" />
                                    <ui:Button Appearance="Transparent" Padding="6"
                                               Command="{Binding DataContext.DeleteTermCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                               CommandParameter="{Binding}" ToolTip="Delete"
                                               AutomationProperties.Name="{Binding DeleteName}"
                                               Icon="{ui:SymbolIcon Delete24}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Empty state. The second sentence is the ONLY discovery hook v1.3 ships, so it names
                 the right-click gesture explicitly. No button — the add form is directly below. -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <ui:SymbolIcon Symbol="Chat24" FontSize="36" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="No terms yet" Style="{DynamicResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center" Margin="0,10,0,4" />
                <TextBlock TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Add names, products, and jargon you want Jot to spell your way. Right-click a wrong word in any transcript to add it in one step." />
            </StackPanel>

            <TextBlock Text="No terms match your search."
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <ui:CardExpander Grid.Row="4" Margin="0,10,0,0" Icon="{ui:SymbolIcon Add24}"
                         IsExpanded="{Binding IsEditing, Mode=OneWay}">
            <ui:CardExpander.Header>
                <TextBlock Text="{Binding FormHeader}" FontWeight="SemiBold" />
            </ui:CardExpander.Header>
            <StackPanel>

                <!-- Normal add/edit form -->
                <StackPanel Visibility="{Binding IsImportMode, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <TextBlock Text="Term" Margin="0,0,0,4" />
                    <!-- Monospaced so the term reads as data, not prose (mirrors the Mac's row). -->
                    <ui:TextBox x:Name="TermBox" FontFamily="{StaticResource JotMonoFont}"
                                Text="{Binding NewTerm, UpdateSourceTrigger=PropertyChanged}">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding AddTermCommand}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>
                    <TextBlock Text="How you want it spelled." Margin="0,4,0,0" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <TextBlock Text="{Binding SpottabilityWarning}" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource JotWarningBrush}"
                               Visibility="{Binding ShowSpottabilityWarning, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="Renaming clears what Jot learned about this term."
                               Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource JotWarningBrush}"
                               Visibility="{Binding ShowRenameWarning, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="When Jot hears  (optional)" Margin="0,14,0,4" />
                    <WrapPanel>
                        <ItemsControl ItemsSource="{Binding NewAliases}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,6,6" Padding="8,3" CornerRadius="12"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center" />
                                            <ui:Button Padding="4,0" Margin="4,0,0,0" Appearance="Transparent"
                                                       Icon="{ui:SymbolIcon Dismiss12}"
                                                       AutomationProperties.Name="Remove spelling"
                                                       Command="{Binding DataContext.RemoveAliasCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ui:TextBox PlaceholderText="Add a sounds-like spelling" Width="240" Margin="0,0,0,6"
                                    Text="{Binding NewAlias, UpdateSourceTrigger=PropertyChanged}">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding AddAliasCommand}" />
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>
                    </WrapPanel>
                    <TextBlock Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="The wrong spellings Jot writes instead. Each one makes Jot likelier to fix it." />
                </StackPanel>

                <!-- Bulk paste import (ux §2.5) -->
                <StackPanel Visibility="{Binding IsImportMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ImportCountText, Mode=OneWay}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding ImportPreview}" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <TextBlock Text="{Binding CapMessage, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,10,0"
                               FontSize="12" Foreground="{DynamicResource JotWarningBrush}"
                               Visibility="{Binding ShowCapMessage, Converter={StaticResource BoolToVis}}" />
                    <ui:Button Content="Cancel" Margin="0,0,8,0" Command="{Binding CancelEditCommand}"
                               Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />
                    <ui:Button Content="Add as one term" Margin="0,0,8,0" Command="{Binding AddAsOneTermCommand}"
                               Visibility="{Binding IsImportMode, Converter={StaticResource BoolToVis}}" />
                    <ui:Button Content="{Binding ImportButtonText, Mode=OneWay}" Appearance="Primary"
                               Command="{Binding AddTermCommand}"
                               Visibility="{Binding IsImportMode, Converter={StaticResource BoolToVis}}" />
                    <ui:Button Content="{Binding AddButtonText}" Appearance="Primary"
                               IsEnabled="{Binding CanAdd}" Command="{Binding AddTermCommand}"
                               Visibility="{Binding IsImportMode, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                </StackPanel>
            </StackPanel>
        </ui:CardExpander>
    </Grid>
</Page>
