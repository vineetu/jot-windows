<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms interop: NotifyIcon (system tray) has no first-class WPF control -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Jot</AssemblyName>
    <RootNamespace>Jot</RootNamespace>
    <Version>1.3.0</Version> <!-- keep aligned with Package*.appxmanifest Identity Version (feeds feedback reports + env log) -->
    <ApplicationIcon>Assets\jot.ico</ApplicationIcon>
    <!-- ONNX Runtime ships native (win-x64) libraries; pin the platform so they are restored/copied. -->
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Enables targets that generate package layout, required for running with winapp run or msix packaging -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Build flavor. 'Public' (default) = the Microsoft Store build: bring-your-own cloud AI
         providers, no PFB. 'Sony' = the internal build where PFB is the ONLY online AI (external
         cloud providers removed, and the Sony gateway hostnames compiled in). Select with
         `dotnet build -p:Flavor=Sony`. -->
    <Flavor Condition="'$(Flavor)' == ''">Public</Flavor>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tests exercise internal engine pieces (MelFrontend/StreamingMel byte-exactness). -->
    <InternalsVisibleTo Include="Jot.Tests" />
    <!-- The CLI reuses app internals rather than forking them (VocabularyRunner.Enrich, the
         corrections.json serializer options). -->
    <InternalsVisibleTo Include="Jot.Cli" />
  </ItemGroup>

  <ItemGroup>
    <!-- Common-word frequency lists for the vocabulary gate's over-correction brake (21 languages,
         ~5 MB), copied from jot-shared @5326460. EMBEDDED, not Content, on purpose: on macOS the
         #1 shipped bug in this feature was the list silently missing from the bundle, which turns
         the brake into a no-op and makes every "name" become "Jamy". An embedded resource cannot
         go missing without failing the build. -->
    <EmbeddedResource Include="Vocabulary\Resources\common-words*.txt" />
  </ItemGroup>

  <!-- Flavor gate: defines the SONY compile symbol used by Services/Ai/PfbGateway.cs, PfbAuth.cs
       and BuildFlavor.cs to include the Sony-only providers, gateway URLs, and self-test. -->
  <PropertyGroup Condition="'$(Flavor)' == 'Sony'">
    <DefineConstants>$(DefineConstants);SONY</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- WASAPI microphone capture + resampling to 16 kHz mono -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <!-- WinApp CLI integration: enables 'dotnet run' support for packaged apps and MSIX packaging.
         NOT Microsoft.WindowsAppSDK — Jot is plain WPF (no WinUI3/app-lifecycle APIs used), and that
         package transitively ships its own onnxruntime.dll that collides with the one already used for
         STT (Microsoft.ML.OnnxRuntime.DirectML) — APPX1101 duplicate-payload-path build error. -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.4.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <!-- Offline QR generation for the "Jot for iPhone" card — pure managed, no native deps, no network
         (PngByteQRCode → PNG bytes, so no System.Drawing dependency either). -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- Auto-updating installer (Setup.exe) + delta updates from GitHub Releases -->
    <PackageReference Include="Velopack" Version="1.2.0" />
    <!-- On-device speech-to-text: Parakeet-TDT ONNX. DirectML package = CPU + DirectML EPs.
         Native runtime pinned to 1.20.1 (newer builds fail DLL init on this box). -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.20.1" />
    <!-- Newer DirectML runtime than the 1.15.2 that ORT.DirectML bundles: 1.15.2 rejects Nemotron's
         int4 (4-bit) ops on this GPU ("parameter is incorrect"); 1.15.4 supports them. -->
    <PackageReference Include="Microsoft.AI.DirectML" Version="1.15.4" />
    <!-- SentencePiece BPE encoder for the CTC word spotter (term → token ids). Fully managed; its
         only transitive dep is Google.Protobuf, also managed — so unlike WindowsAppSDK it brings no
         second native runtime and cannot recreate the APPX1101 duplicate-payload collision above. -->
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- App icon + hi-res logo, embedded as WPF resources so windows/tray/About load them via pack URI -->
    <Resource Include="Assets\jot.ico" />
    <Resource Include="Assets\jot-logo.png" />
    <!-- FFmpeg (decodes any audio/video format for file import) is no longer bundled — it's ~138 MB
         and only needed by the optional file-import feature. Jot.Import.FfmpegInstaller downloads it
         on first use from a standalone GitHub release, decoupled from the app's own version tags. -->
  </ItemGroup>

  <ItemGroup>
    <!-- jot.ico is excluded here because it's already embedded as a <Resource> above (line 46). Listing
         the same file as both Resource and Content drops the embedded copy, so the pack URI
         (pack://application:,,,/Assets/jot.ico) resolves to null and the tray/window icon load crashes
         startup. Keep the app icon Resource-only; the rest of Assets\ is MSIX tile/store artwork. -->
    <Content Include="Assets\**\*" Exclude="Assets\jot.ico;Assets\jot-logo.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Official transcribe.cpp v0.1.3 / a94e021 CPU+Vulkan natives. Restored at build from the GitHub
       tarball (not Handy). Sit next to Jot.exe so GgmlNativeLocator finds them without JOT_GGML_NATIVE.
       The folder is gitignored (~80 MB); the restore script is the source of truth.
       Content items are added INSIDE the target: a static Include="natives\*" is empty on a clean
       tree (the files do not exist at evaluation time). -->
  <PropertyGroup>
    <GgmlNativesDir>$(MSBuildThisFileDirectory)natives</GgmlNativesDir>
  </PropertyGroup>
  <Target Name="RestoreGgmlNatives" BeforeTargets="BeforeBuild">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\scripts\restore-ggml-natives.ps1&quot; -OutDir &quot;$(GgmlNativesDir)&quot;" />
  </Target>
  <!-- Incremental builds: files exist at evaluation time so testhost/publish pick them up too. -->
  <ItemGroup>
    <Content Include="natives\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Dynamic Content Include in a target does not reliably join GetCopyToOutputDirectoryItems
       on a clean tree. Copy the restored files ourselves so they sit next to Jot.exe. -->
  <Target Name="CopyGgmlNatives" AfterTargets="Build">
    <ItemGroup>
      <_GgmlNativeFiles Include="$(GgmlNativesDir)\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_GgmlNativeFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishGgmlNatives" AfterTargets="Publish">
    <ItemGroup>
      <_GgmlNativeFiles Include="$(GgmlNativesDir)\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_GgmlNativeFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
