<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- NEVER "jot"/"Jot": on case-insensitive NTFS this assembly's dll overwrites the referenced Jot.dll
         in the shared output dir and the exe dies at startup (and NuGet keys on AssemblyName, so restore
         fails with "Ambiguous project name 'jot'"). The jot.exe filename comes from the copy target below;
         the apphost embeds Jot.Cli.dll at build time, so renaming the exe is safe. -->
    <AssemblyName>Jot.Cli</AssemblyName>
    <RootNamespace>Jot.Cli</RootNamespace>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Nothing WPF ever runs here; this only makes the Jot.csproj ProjectReference resolve the
         WindowsDesktop framework. -->
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jot.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jot\Jot.csproj" />
  </ItemGroup>

  <Target Name="CopyToJotExe" AfterTargets="Build">
    <Copy SourceFiles="$(TargetDir)Jot.Cli.exe" DestinationFiles="$(TargetDir)jot.exe"
          Condition="Exists('$(TargetDir)Jot.Cli.exe')" />
  </Target>

  <Target Name="CopyToJotExeOnPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(PublishDir)Jot.Cli.exe" DestinationFiles="$(PublishDir)jot.exe"
          Condition="Exists('$(PublishDir)Jot.Cli.exe')" />
  </Target>

</Project>
